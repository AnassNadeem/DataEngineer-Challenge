
# Headers for CSV Files. 


goal scorer = date, home_team, away_team,  team,  scorer,  minute,  own_goal,  penalty

results =  date, home_team, away_team, home_score, away_score, tournament, city, country, neutral

shootouts =  date, home_team, away_team, winner,  first_shooter



# 1. Create a query that calculates the average number of goals per game between 1900 and 2000.


 # Start = 1900-01-01
 # End = 2001-01-01


SELECT AVG(home_score + away_score) AS avg_goals
FROM read_csv('results.csv')
WHERE date >=  1900-01-01
    AND date < 2001-01-01


# 2. Create a query that counts the number of shootouts wins by country and arrange in alphabetical order.


SELECT winner AS country, 
    COUNT(*) AS shootout_wins
FROM read_csv('shootouts.csv')
GROUP BY winner
ORDER BY winner;




-- goals for a match
SELECT r.*, g.scorer, g.minute, g.own_goal, g.penalty
FROM results r
LEFT JOIN goalscorers g
  USING (date, home_team, away_team);

-- shootout, if there was one
SELECT r.*, s.winner, s.first_shooter
FROM results r
LEFT JOIN shootouts s
  USING (date, home_team, away_team);


